<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>DotAbyss.Local</AssemblyName>
    <RootNamespace>DotAbyss.Local</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameRoot Condition="'$(GameRoot)' == ''">$(MSBuildThisFileDirectory)..\..\dotabyss_unpacked</GameRoot>
    <LoaderDir>$(GameRoot)\assets\LemonLoader\runtime\loader\net6</LoaderDir>
    <InteropDir>$(GameRoot)\assets\LemonLoader\runtime\interop</InteropDir>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\*.cs" />
    <Reference Include="MelonLoader"><HintPath>$(LoaderDir)\MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(LoaderDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(LoaderDir)\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppAbsf"><HintPath>$(InteropDir)\Il2CppAbsf.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppProject"><HintPath>$(InteropDir)\Il2CppProject.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(InteropDir)\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppUniTask"><HintPath>$(InteropDir)\Il2CppUniTask.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(InteropDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule"><HintPath>$(InteropDir)\UnityEngine.UnityWebRequestModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(InteropDir)\Il2CppProject.dll')" Text="Set -p:GameRoot to the unpacked APK directory." />
  </Target>
</Project>
