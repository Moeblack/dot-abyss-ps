<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>AbyssMod</AssemblyName>
    <RootNamespace>AbyssMod</RootNamespace>
    <Version>1.2.0</Version>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <ClientDir Condition="'$(ClientDir)' == ''">$(MSBuildProjectDirectory)\..\..\dotabyss_pc\toolchain\runtime</ClientDir>
    <SourceDir Condition="'$(SourceDir)' == ''">$(MSBuildProjectDirectory)\..\..\reference\AbyssMod-translator\AbyssMod</SourceDir>
    <DependencyDir Condition="'$(DependencyDir)' == ''">$(MSBuildProjectDirectory)\..\artifacts\translation\dependencies</DependencyDir>
    <MappingPath Condition="'$(MappingPath)' == ''">$(MSBuildProjectDirectory)\..\artifacts\translation\master_mapping.json</MappingPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SourceDir)\**\*.cs" Exclude="$(SourceDir)\bin\**;$(SourceDir)\obj\**" />
    <Compile Include="PluginInfo.cs" />
    <Compile Include="runtime\*.cs" />
    <Reference Include="$(ClientDir)\BepInEx\core\*.dll" Exclude="$(ClientDir)\BepInEx\core\dobby.dll" Private="false" />
    <Reference Include="$(ClientDir)\BepInEx\interop\*.dll" Private="false" />
    <Reference Include="Utility" HintPath="$(DependencyDir)\Utility.dll" Private="false" />
    <EmbeddedResource Include="$(MappingPath)" LogicalName="AbyssMod.master_mapping.json" />
  </ItemGroup>
  <Target Name="RequireDependencies" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(SourceDir)\Core\Plugin.cs')" Text="Fetch the pinned AbyssMod source before building." />
    <Error Condition="!Exists('$(ClientDir)\BepInEx\interop\Project.dll')" Text="The exact PC interop assemblies are required." />
    <Error Condition="!Exists('$(DependencyDir)\Utility.dll')" Text="The verified translation Utility.dll is required." />
    <Error Condition="'$(Configuration)' != 'Release'" Text="Build the translation integration in Release configuration." />
  </Target>
</Project>
